{
  "name": "rekey",
  "version": "0.1.0",
  "private": true,
  "description": "An agent that rotates leaked API keys and fixes everything that depended on them.",
  "type": "module",
  "bin": {
    "rekey": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "run": "tsx src/index.ts run",
    "verify": "tsx src/index.ts verify",
    "eval": "tsx src/index.ts eval",
    "approve": "tsx src/index.ts approve",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@octokit/rest": "^21.0.0",
    "@slack/bolt": "^4.1.0",
    "@aws-sdk/client-iam": "^3.658.0",
    "@aws-sdk/client-sts": "^3.658.0",
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "libsodium-wrappers": "^0.7.15",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/js-yaml": "^4.0.9",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.5.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
