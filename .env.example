# Copy to .env and fill in. Never commit .env — it's gitignored on purpose.
# Every value here is a credential. Rotate anything that leaks here the way
# Rekey itself would.

# --- GitHub ---
GITHUB_TOKEN=
GITHUB_OWNER=jasmineyyip
GITHUB_REPO=rekey-demo-app

# --- AWS ---
AWS_REGION=us-east-1
# rekey-agent creds: can create/update/delete access keys for rekey-demo only
AWS_AGENT_ACCESS_KEY_ID=
AWS_AGENT_SECRET_ACCESS_KEY=
# rekey-verifier creds: read-only on rekey-demo
AWS_VERIFIER_ACCESS_KEY_ID=
AWS_VERIFIER_SECRET_ACCESS_KEY=
AWS_TARGET_USER_NAME=rekey-demo
AWS_TARGET_USER_ARN=

# --- Vercel ---
VERCEL_TOKEN=
VERCEL_PROJECT_ID=

# --- Slack ---
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_CHANNEL=rekey

# --- Linear ---
LINEAR_API_KEY=
LINEAR_TEAM_ID=

# --- Datadog ---
DD_API_KEY=
DD_APP_KEY=
DD_SITE=datadoghq.com

# --- Runtime ---
# live | twin | mock — selects which base URL each tool client hits
TARGET=mock
